# Environment Variables
# Copy this file to .env and fill in the values
#
# Two options for infrastructure:
#   A) Cloud (recommended for quick start, no Docker needed):
#      - Neon (Postgres + pgvector): https://neon.tech
#      - Upstash (Redis): https://upstash.com
#      - Meilisearch Cloud: https://www.meilisearch.com/cloud
#
#   B) Local via Docker:
#      Run `docker compose up -d` and use the local defaults below.

# ── Database (Neon cloud or local Docker) ─────────────
# Cloud:  postgresql://<user>:<pass>@<host>.neon.tech/neondb?sslmode=require
# Local:  postgresql://codexa:codexa@localhost:5432/codexa
DATABASE_URL=postgresql://codexa:codexa@localhost:5432/codexa

# ── Redis (Upstash cloud or local Docker) ─────────────
# Cloud:  rediss://default:<pass>@<host>.upstash.io:6379
# Local:  redis://localhost:6379
REDIS_URL=redis://localhost:6379

# ── Meilisearch (Cloud or local Docker) ───────────────
# Cloud:  https://ms-<id>.sgp.meilisearch.io (+ your API key)
# Local:  http://localhost:7700 (+ codexa_dev_master_key)
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=codexa_dev_master_key

# ── Cloudflare R2 (S3-compatible) ────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=codexa-uploads
R2_PUBLIC_URL=

# ── Auth (NextAuth / Auth.js) ────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-in-production
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── AI Service ────────────────────────────────────────
AI_SERVICE_URL=http://localhost:8000
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-20250514

# ── Judge0 (Code Execution) ──────────────────────────
JUDGE0_URL=http://localhost:2358

# ── Monitoring ────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
